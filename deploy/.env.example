# Copy to deploy/.env, then either `set -a; . deploy/.env; set +a` before `make up`, or
# `docker compose --env-file deploy/.env ...`. Compose does NOT read deploy/.env
# automatically — it only auto-loads ./.env at the project root.
#
#   cp deploy/.env.example deploy/.env
#
# deploy/.env is gitignored (deploy/.gitignore). Never put a key in .env.example.
#
# =======================================================================================
# HOW TO READ THE "UNVERIFIED" MARKERS
#
# Nothing below has been pulled. On this box (2026-08-15) nvcr.io returns 401 — there are
# no NGC credentials and no ~/.ngc — and the user is not in the `docker` group, so not one
# `docker pull` or `docker manifest inspect` has been run against any of these.
#
# Two separate things need confirming for every image, and passing one does not imply the
# other:
#
#   1. AN aarch64 MANIFEST EXISTS.        docker manifest inspect <image> | grep -i arm64
#   2. IT ACTUALLY SUPPORTS sm_121.       run it and check the model loads.
#      sm_121 is NOT sm_100 (datacenter Blackwell) and NOT sm_120 (RTX 50xx). A container
#      whose kernels were compiled for either will pull cleanly, start cleanly, and then
#      fail at the first kernel launch. This is the failure mode that eats an afternoon.
#
# Record what you verified next to each line as you go.
# =======================================================================================


# ---------------------------------------------------------------------------------------
# NGC — the external dependency. CLAUDE.md flags it as the one to start early: it gates
# Cosmos, the Nemotron NIMs, embed, rerank and DeepStream all at once.
#
#   1. get a key at https://ngc.nvidia.com/setup/api-key
#   2. docker login nvcr.io -u '$oauthtoken' -p <API_KEY>
#   3. NGC_API_KEY=<API_KEY> here (the NIM containers read it at runtime, separately
#      from the docker login used to pull)
#
# The key is a secret. It lives here or in your shell, never in docker-compose.yml.
# ---------------------------------------------------------------------------------------
NGC_API_KEY=

# Only needed if the chosen Cosmos weights are behind a gated HuggingFace repo.
# HuggingFace and PyPI are reachable from this box even though nvcr.io is not, so pulling
# weights from HF and serving them with a non-NVIDIA vLLM image is a live alternative
# route while the NGC key is outstanding.
HF_TOKEN=


# ---------------------------------------------------------------------------------------
# VLM — SPEC §10 D1 IS OPEN. Do not fill VLM_MODEL from taste.
#
# The block-0 caption benchmark decides it (SPEC §9: `time` a single 5-frame caption; if
# it exceeds 4 s, D1 is forced to a smaller variant). config/settings.yaml keeps
# vlm.model null for the same reason, and docker-compose.yml uses ${VLM_MODEL:?...} so an
# unset value stops compose with a message instead of serving a model nobody chose.
#
# Whatever you pick: bf16, not a quantization. Quantized Cosmos Reason variants are
# documented to hallucinate (SPEC §2.4), and a hallucinating caption is worse than a slow
# one because it is indistinguishable from a correct one in the index.
# ---------------------------------------------------------------------------------------

# UNVERIFIED — THE HIGHEST-RISK LINE IN THE DEPLOYMENT.
# There is no default in docker-compose.yml because no ARM64 + sm_121 vLLM image has been
# confirmed. Candidates, in the order worth trying:
#   a) an NVIDIA-published vLLM container from nvcr.io  — needs the NGC key first, and
#      the aarch64 manifest and sm_121 kernels both still need checking.
#   b) vllm/vllm-openai from Docker Hub — check whether the tag you want has a linux/arm64
#      manifest at all; historically many vLLM releases are linux/amd64 only.
#   c) build vLLM from source for aarch64 + sm_121. Slowest, but CLAUDE.md records a
#      working torch 2.11.0+cu130 aarch64 build already on this box, so CUDA 13 on this
#      arch is less hostile than it looks.
# Whichever you use, confirm the entrypoint is the OpenAI-compatible api_server; the
# `command:` in docker-compose.yml passes args, not a program.
VLLM_IMAGE=

# The HF repo id or local path vLLM serves. UNRESOLVED — SPEC §10 D1.
VLM_MODEL=

# What clients call it. Cosmetic; config/settings.yaml vlm.model must eventually agree.
VLM_SERVED_NAME=cosmos-live

# ---- memory, SPEC §7.1 -----------------------------------------------------------------
# 52 GB of 128 = rows "VLM weights | 18" + "VLM KV-cache | 34". Rounded down from 0.406.
# Raising this is the single easiest way to OOM the box: the ask LLM needs its 27 GB and
# there is no VRAM to spill into (CLAUDE.md invariant 1).
VLLM_GPU_MEMORY_UTILIZATION=0.40

# The explicit KV-cache cap: KV bytes = MAX_NUM_SEQS x MAX_MODEL_LEN x bytes_per_token.
# queue.max_inflight is 1 (one camera = one request in flight, batching does not help us),
# so 2 is one live slot plus slack for a deep job arriving mid-caption.
VLLM_MAX_NUM_SEQS=2
VLLM_MAX_MODEL_LEN=16384

# Version-dependent flags, kept out of docker-compose.yml so it never asserts a syntax
# that has not been run. Once you know the vLLM version, the two worth adding:
#
#   --limit-mm-per-prompt          bounds multimodal KV. Ingest sends 5 frames per window
#                                  (SPEC §2.2), the deep path more. The accepted syntax
#                                  changed across vLLM versions (`image=8` vs a JSON dict)
#                                  — check `--help` on YOUR image before setting it.
#   --kv-cache-memory-bytes        a direct cap on the 34 GB row, if your vLLM has it.
#                                  36507222016 == 34 GiB.
#   --num-gpu-blocks-override      the older direct KV cap. Blocks, not bytes: divide the
#                                  34 GB by the model's per-block KV size, which depends
#                                  on layers/kv_heads/head_dim — so it can only be
#                                  computed after D1 lands.
#
# Example once verified:
#   VLLM_EXTRA_ARGS=--kv-cache-memory-bytes 36507222016 --limit-mm-per-prompt image=8
VLLM_EXTRA_ARGS=


# ---------------------------------------------------------------------------------------
# NIM services — embed, rerank, ask LLM.
#
# All three are nvcr.io. The repository paths suggested below follow the published NIM
# naming convention combined with the model names already in config/settings.yaml. They
# are EDUCATED GUESSES AT THE PATH AND NOTHING MORE: no tag has been listed, no manifest
# inspected, no aarch64 build confirmed. Check against the NGC catalogue once the key
# exists, and pin an explicit version — never `:latest` for a demo you have to rehearse.
# ---------------------------------------------------------------------------------------

# UNVERIFIED. config/settings.yaml index.embed.model: llama-3.2-nemoretriever-300m-embed-v1
# Likely path: nvcr.io/nim/nvidia/llama-3.2-nemoretriever-300m-embed-v1:<TAG>
# Serves on 8001 (index.embed.endpoint). Asymmetric model — settings.yaml already sets
# query_input_type/passage_input_type; swapping them costs recall silently.
EMBED_IMAGE=

# UNVERIFIED. config/settings.yaml index.rerank.model: llama-3.2-nv-rerankqa-1b-v2
# Likely path: nvcr.io/nim/nvidia/llama-3.2-nv-rerankqa-1b-v2:<TAG>
# Serves on 8002. Its route is /ranking, not an OpenAI-shaped one — settings.yaml knows.
RERANK_IMAGE=

# UNVERIFIED, and SPEC §10 D3 IS OPEN: Nemotron 3 Nano vs 3.5 Lightning is undecided.
# Lightning is newer and desktop-targeted; CONFIRM AN ARM64/sm_121 CONTAINER EXISTS
# before betting the demo on it. config/settings.yaml agent.model is null for this reason.
# Serves on 8003 (agent.endpoint).
LLM_IMAGE=
LLM_SERVED_NAME=

# Shared NIM model cache. Bind-mounted so a `compose down -v` does not re-download.
NIM_CACHE_DIR=./deploy/volumes/nim

# HuggingFace cache for vLLM weights. Same reasoning; point it at a bigger disk if needed
# (this box has ~3.3 TB free on /).
HF_CACHE_DIR=./deploy/volumes/hf


# ---------------------------------------------------------------------------------------
# Milvus stack — SPEC §3.2. SPEC §7.1 row "Milvus | 6".
# ---------------------------------------------------------------------------------------

# etcd and minio publish linux/arm64 manifests — high confidence, still UNPULLED here.
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.16
MINIO_IMAGE=minio/minio:RELEASE.2024-05-28T17-19-04Z

# UNVERIFIED for linux/arm64. Milvus ships arm64 images for some releases only; this tag
# has not been checked. `docker manifest inspect $MILVUS_IMAGE | grep -i arm64`.
MILVUS_IMAGE=milvusdb/milvus:v2.4.15

# Local-only development defaults. MinIO is not published to the host at all, so these
# never leave the compose network — change them anyway if that makes you happier.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin


# ---------------------------------------------------------------------------------------
# App services
# ---------------------------------------------------------------------------------------

# Built locally from deploy/Dockerfile.app. NEVER BUILT — see the caveats in that file,
# especially that Debian's ffmpeg is not the 6.1.1 build verified on the host.
APP_IMAGE=spark-vision/app:dev
